{
  "name": "solarwise-sa",
  "version": "1.0.0",
  "private": true,
  "description": "South African solar decision-support platform",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "node --test backend/tests/*.test.js",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "node backend/scripts/prisma-command.js migrate dev",
    "db:deploy": "node backend/scripts/prisma-command.js migrate deploy",
    "db:status": "node backend/scripts/prisma-command.js migrate status",
    "db:check": "node backend/scripts/db-check.js",
    "db:seed": "node backend/scripts/prisma-command.js db seed"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.10.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
