NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://solarwise:replace-with-your-database-password@localhost:5432/solarwise?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:3000
# Public API endpoints; change only when using an approved compatible endpoint.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_3
# Weather integration resilience limits.
OPEN_METEO_TIMEOUT_MS=8000
OPEN_METEO_RETRIES=2
OPEN_METEO_RETRY_DELAY_MS=300
OPEN_METEO_CACHE_TTL_MS=900000
# PVGIS integration timeout.
PVGIS_TIMEOUT_MS=12000
# Required only when creating/updating the initial administrator with npm run db:seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
